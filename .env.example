# Copie para .env e preencha. NUNCA commitar o .env (esta no .gitignore).
# Em producao esses valores vivem em GitHub Secrets, nao em arquivo.

# Loja 1 Nuvemshop (Carlota Costa + Simone Gomes)
NUVEMSHOP_STORE1_ID=
NUVEMSHOP_STORE1_TOKEN=

# Loja 2 Nuvemshop (Ritmi Studio + mix)
NUVEMSHOP_STORE2_ID=
NUVEMSHOP_STORE2_TOKEN=

# Identificacao obrigatoria no User-Agent da API Nuvemshop (nome do app + contato)
NUVEMSHOP_USER_AGENT=EcommerceControl (joaobressann@gmail.com)

# GA4 (F1.4) - service account. Em dev pode ser caminho do arquivo JSON;
# em producao e o conteudo JSON inteiro no Secret GA4_CREDENTIALS_JSON.
GA4_CREDENTIALS_JSON=
# IDs das propriedades ja tem default no config.py (L1=390081039, L2=412507997).
# So preencha para sobrescrever:
# GA4_PROPERTY_STORE1=
# GA4_PROPERTY_STORE2=
